/* Additions for the review proposal. The copied styles.css remains the visual base. */
:root {
  --proposal-blue: #316db2;
  --proposal-blue-pale: #eaf2fb;
  --proposal-teal: #00a2a4;
  --proposal-line: #e2e9f0;
  --proposal-muted: #78879a;
}

.dashboard-hero {
  align-items: start;
  grid-template-columns: minmax(240px, 0.85fr) minmax(360px, 1.15fr);
  grid-template-rows: auto auto;
  gap: 18px;
  min-height: 0;
  padding-top: 34px;
  padding-bottom: 42px;
}

.dashboard-hero .hero-copy {
  grid-column: 1 / -1;
  grid-row: 1;
  align-self: start;
  padding-right: 0;
}

.dashboard-hero .hero-copy h1 { 
  max-width: none; 
}


.control-card {
  position: relative;
  z-index: 1;
  min-width: 0;
  padding: 20px;
  border: 1px solid rgba(220, 231, 240, 0.98);
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 14px 36px rgba(35, 67, 101, 0.065);
}

.date-card {
  grid-column: 1; 
  grid-row: 2;
}
.port-card { 
  grid-column: 1; 
  grid-row: 2; 
}
.scenario-panel { 
  grid-column: 1 / -1; 
  grid-row: 3; 
  padding: 20px 22px;
}

.control-card-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 18px;
}

.control-card-heading .panel-label,
.scenario-title .panel-label { margin-bottom: 5px; }

.control-card-heading h2,
.scenario-title h2 {
  margin: 0;
  color: #172944;
  font-size: 17px;
  font-weight: 800;
  letter-spacing: -0.05em;
}

.card-icon {
  display: grid;
  width: 32px;
  height: 32px;
  place-items: center;
  border-radius: 10px;
  background: #edf4fb;
  color: var(--proposal-blue);
  font-size: 17px;
}

.year-picker-wrap { position: relative; }
.year-picker {
  display: grid;
  grid-template-columns: 42px 1fr 42px;
  align-items: center;
  min-height: 48px;
  border: 1px solid #dce5ee;
  border-radius: 12px;
  background: #fbfcfe;
}

.year-arrow,
.year-toggle {
  height: 46px;
  border: 0;
  background: transparent;
  cursor: pointer;
}

.year-arrow {
  color: #4a6f9d;
  font-family: "DM Sans", sans-serif;
  font-size: 20px;
  font-weight: 700;
}

.year-arrow:disabled { color: #bdc7d2; cursor: default; }
.year-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  color: #203b5c;
  font-size: 16px;
  font-weight: 800;
}

.year-toggle .chevron { width: 6px; height: 6px; }
.year-options {
  position: absolute;
  z-index: 10;
  top: calc(100% + 7px);
  right: 0;
  left: 0;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 5px;
  max-height: 190px;
  padding: 9px;
  overflow-y: auto;
  border: 1px solid #dfe7ef;
  border-radius: 12px;
  background: #fff;
  box-shadow: 0 14px 32px rgba(27, 48, 75, 0.15);
}

.year-options[hidden] { display: none; }
.year-option {
  min-height: 34px;
  border: 0;
  border-radius: 8px;
  background: transparent;
  color: #55677d;
  font-family: "DM Sans", var(--font);
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
}

.year-option:hover,
.year-option:focus-visible { outline: none; background: #eef5fc; color: var(--proposal-blue); }
.year-option[aria-selected="true"] { background: var(--proposal-blue-pale); color: #1e5595; }

.month-picker-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin: 20px 0 10px;
  color: #344b66;
  font-size: 12px;
  font-weight: 700;
}

.month-hint { color: #95a1af; font-size: 10px; font-weight: 500; }
.month-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }
.month-option {
  min-height: 42px;
  border: 1px solid #e3e9ef;
  border-radius: 10px;
  background: #fff;
  color: #66768b;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  transition: border-color 150ms ease, background 150ms ease, color 150ms ease;
}

.month-option:disabled { background: #f7f8fa; color: #b9c2cd; cursor: default; }
.month-option:not(:disabled):hover { border-color: #a9c6e5; color: #285f9c; }
.month-option[aria-pressed="true"] {
  border-color: #b7d0ec;
  background: #e7f0fa;
  color: #245f9f;
  box-shadow: inset 0 0 0 1px rgba(49, 109, 178, 0.06);
}

.port-card-heading { align-items: center; margin-bottom: 12px; }
.port-count {
  flex: 0 0 auto;
  padding: 6px 9px;
  border-radius: 999px;
  background: #f0f5f9;
  color: #71839a;
  font-size: 10px;
  font-weight: 700;
}

.map-tools { display: flex; align-items: center; gap: 9px; margin-bottom: 8px; }
.field-label { display: block; color: #67788e; font-size: 10px; font-weight: 700; }
.country-filter {
  min-width: 0;
  flex: 1;
  height: 34px;
  padding: 0 10px;
  border: 1px solid #e0e7ee;
  border-radius: 8px;
  background: #fbfcfe;
  color: #405672;
  font-family: var(--font);
  font-size: 11px;
}

.port-search {
  display: block;
  width: 100%;
  height: 36px;
  margin-bottom: 9px;
  padding: 0 12px;
  border: 1px solid #e0e7ee;
  border-radius: 9px;
  background: #fff;
  color: #273d58;
  font-family: var(--font);
  font-size: 11px;
}

.port-search::placeholder { color: #9aa6b4; }
.country-filter:focus-visible,
.port-search:focus-visible,
.volume-input-wrap input:focus-visible { outline: 3px solid rgba(49, 109, 178, 0.2); outline-offset: 1px; }

.map-shell {
  position: relative;
  height: 225px;
  overflow: hidden;
  border: 1px solid #dfe8ef;
  border-radius: 12px;
  background: #edf4f7;
}

#world-map { width: 100%; height: 100%; background: #eaf2f5; }
.map-fallback {
  position: absolute;
  z-index: 800;
  top: 8px;
  right: 36px;
  left: 8px;
  display: grid;
  place-items: center start;
  margin: 0;
  padding: 8px 10px;
  border: 1px solid #e3e9ef;
  border-radius: 8px;
  background: rgba(248, 250, 252, 0.94);
  color: #6f7f92;
  box-shadow: 0 4px 12px rgba(19, 35, 62, 0.08);
  font-size: 9px;
}

.map-fallback[hidden] { display: none; }
.leaflet-container { font-family: var(--font); }
.leaflet-control-attribution { font-size: 8px !important; }
.leaflet-tooltip {
  border: 1px solid #d7e1eb;
  border-radius: 7px;
  box-shadow: 0 4px 14px rgba(19, 35, 62, 0.12);
  color: #29415f;
  font-family: var(--font);
  font-size: 10px;
  font-weight: 700;
}

.leaflet-tooltip-selected {
  border-color: #316db2;
  background: #fff;
  color: #1d5592;
}

.leaflet-popup-content-wrapper { border-radius: 10px; }
.leaflet-popup-content { margin: 10px 13px; font-family: var(--font); font-size: 11px; line-height: 1.55; }
.map-caption { display: flex; align-items: center; gap: 7px; margin: 7px 0 13px; color: #8795a6; font-size: 9px; }
.map-dot { width: 7px; height: 7px; border: 2px solid #fff; border-radius: 50%; background: var(--proposal-blue); box-shadow: 0 0 0 1px var(--proposal-blue); }

.selected-port-row {
  display: grid;
  grid-template-columns: minmax(0, 0.9fr) minmax(170px, 1.1fr);
  align-items: end;
  gap: 13px;
  padding-top: 12px;
  border-top: 1px solid #edf0f3;
}

.selected-port-copy { min-width: 0; padding-bottom: 7px; }
.selected-port-copy strong {
  display: block;
  margin-top: 6px;
  overflow: hidden;
  color: #233b57;
  font-size: 12px;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.volume-field small { display: block; margin-top: 4px; color: #9aa5b2; font-size: 9px; }
.volume-input-wrap {
  display: flex;
  align-items: center;
  gap: 8px;
  height: 37px;
  margin-top: 5px;
  padding: 0 10px;
  border: 1px solid #dce5ee;
  border-radius: 9px;
  background: #fff;
}

.volume-input-wrap input {
  width: 100%;
  min-width: 0;
  height: 33px;
  padding: 0;
  border: 0;
  outline: none;
  color: #203a58;
  font-family: "DM Sans", var(--font);
  font-size: 13px;
  font-weight: 700;
}

.volume-input-wrap input:focus-visible { outline: 0; }
.volume-input-wrap span { color: #8190a1; font-size: 10px; font-weight: 700; }

.scenario-panel {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 14px 20px;
  align-items: start;
}

.scenario-panel-top { grid-column: 1 / -1; display: flex; align-items: end; justify-content: space-between; gap: 16px; }
.scenario-volume-summary { max-width: 55%; margin: 0 0 1px; color: #74849a; font-size: 11px; text-align: right; }
.scenario-choice-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 9px; }
.scenario-choice {
  position: relative;
  display: flex;
  min-height: 84px;
  flex-direction: column;
  align-items: flex-start;
  padding: 11px 13px;
  border: 1px solid #e0e7ee;
  border-radius: 12px;
  background: #fff;
  color: #30465f;
  text-align: left;
  cursor: pointer;
  transition: border-color 150ms ease, background 150ms ease, box-shadow 150ms ease;
}

.scenario-choice:hover { border-color: #bdd1e4; }
.scenario-choice:focus-visible { outline: 3px solid rgba(49, 109, 178, 0.2); outline-offset: 2px; }
.scenario-choice--ecology { --scenario-color: #316db2; }
.scenario-choice--balanced { --scenario-color: #00a2a4; }
.scenario-choice--volume { --scenario-color: #c8893c; }
.scenario-choice-name { margin-top: 4px; color: #213750; font-size: 13px; font-weight: 800; letter-spacing: -0.04em; }
.scenario-choice-hint { margin-top: 4px; color: #8c99a8; font-size: 9px; }
.scenario-choice[aria-pressed="true"] {
  border-color: var(--scenario-color);
  background: color-mix(in srgb, var(--scenario-color), white 95%);
  box-shadow: 0 0 0 2px color-mix(in srgb, var(--scenario-color), transparent 86%);
}

.selection-summary { display: flex; min-width: 225px; flex-direction: column; gap: 7px; }
.summary-cell {
  display: grid;
  grid-template-columns: 60px minmax(0, 1fr);
  align-items: center;
  gap: 6px;
  min-height: 36px;
  padding: 5px 8px;
  border: 1px solid #e9edf1;
  border-radius: 9px;
  background: #fbfcfd;
}


.summary-label { color: #8290a0; font-size: 9px; font-weight: 600; }
.summary-cell strong { overflow: hidden; color: #334a65; font-size: 10px; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.scenario-panel-actions { grid-column: 1 / -1; display: flex; align-items: center; justify-content: space-between; gap: 14px; padding-top: 2px; }
.form-feedback { min-height: 16px; margin: 0; color: #77869a; font-size: 10px; }
.form-feedback.is-error { color: #b34545; }
.analyze-button {
  display: inline-flex;
  min-height: 42px;
  align-items: center;
  justify-content: center;
  gap: 13px;
  padding: 0 17px;
  border: 0;
  border-radius: 10px;
  background: #316db2;
  color: #fff;
  font-size: 11px;
  font-weight: 800;
  cursor: pointer;
  transition: background 150ms ease, transform 150ms ease;
}

.analyze-button:not(:disabled):hover { transform: translateY(-1px); background: #245b9b; }
.analyze-button:disabled { background: #b6c5d4; cursor: not-allowed; }
.analyze-button span { font-family: "DM Sans", sans-serif; font-size: 16px; }

.results-header { min-height: 78px; }
.results-header-link { color: #53647d; font-size: 12px; font-weight: 700; }
.results-header-link:hover { color: var(--proposal-blue); }
.results-page { min-height: calc(100vh - 136px); padding-top: 30px; padding-bottom: 70px; }
.results-heading { padding: 25px 0 20px; }
.results-heading .section-kicker { margin-bottom: 13px; }
.results-step { margin: 0 0 4px; color: var(--proposal-blue); font-family: "DM Sans", sans-serif; font-size: 11px; font-weight: 800; letter-spacing: 0.12em; }
.results-heading h1 { margin: 0; color: #102241; font-size: clamp(30px, 4vw, 40px); font-weight: 800; letter-spacing: -0.065em; }
.results-subtitle { margin: 9px 0 0; color: #748399; font-size: 12px; }

.input-summary-card {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 0;
  margin-bottom: 20px;
  padding: 8px 0;
  border: 1px solid #e2e8ee;
  border-radius: 14px;
  background: rgba(255,255,255,.9);
  box-shadow: 0 8px 24px rgba(35, 67, 101, .04);
}

.input-summary-item { min-width: 0; padding: 9px 19px; border-right: 1px solid #edf0f3; }
.input-summary-item:last-child { border-right: 0; }
.input-summary-item span { display: block; margin-bottom: 5px; color: #8996a5; font-size: 9px; font-weight: 700; }
.input-summary-item strong { display: block; overflow: hidden; color: #263d58; font-size: 12px; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }

.results-layout { display: grid; grid-template-columns: minmax(220px, 0.72fr) minmax(0, 2fr); gap: 18px; align-items: start; }
.scenario-tabs {
  padding: 15px;
  border: 1px solid #e2e8ee;
  border-radius: 16px;
  background: rgba(255,255,255,.85);
  box-shadow: 0 10px 28px rgba(35,67,101,.045);
}

.scenario-tabs-label { margin: 2px 4px 11px; color: #8996a5; font-size: 10px; font-weight: 700; }
.scenario-tab {
  display: grid;
  width: 100%;
  grid-template-columns: 32px minmax(0, 1fr) 18px;
  align-items: center;
  gap: 8px;
  min-height: 55px;
  margin-top: 7px;
  padding: 0 10px;
  border: 1px solid transparent;
  border-radius: 10px;
  background: #f7f9fb;
  color: #66778d;
  text-align: left;
  cursor: pointer;
}

.scenario-tab span { color: #8293a7; font-family: "DM Sans", sans-serif; font-size: 9px; font-weight: 800; }
.scenario-tab strong { color: #43566f; font-size: 11px; font-weight: 800; }
.scenario-tab b { color: #a4afbb; font-family: "DM Sans", sans-serif; font-size: 15px; }
.scenario-tab:hover { background: #eef3f8; }
.scenario-tab[aria-pressed="true"] { border-color: #bdd2e8; background: #eaf2fb; }
.scenario-tab[aria-pressed="true"] span,
.scenario-tab[aria-pressed="true"] strong,
.scenario-tab[aria-pressed="true"] b { color: #245f9f; }
.edit-input-link { display: block; margin: 15px 4px 2px; color: #75869a; font-size: 10px; font-weight: 700; }
.edit-input-link:hover { color: var(--proposal-blue); }

.allocation-card {
  min-width: 0;
  padding: 20px;
  border: 1px solid #e1e8ef;
  border-radius: 17px;
  background: rgba(255,255,255,.9);
  box-shadow: 0 14px 36px rgba(35,67,101,.06);
}

.allocation-card-heading { display: flex; align-items: center; justify-content: space-between; gap: 14px; }
.allocation-card-heading .panel-label { margin-bottom: 5px; }
.allocation-card-heading h2 { margin: 0; color: #1b304b; font-size: 17px; font-weight: 800; letter-spacing: -.045em; }
.allocation-status { padding: 6px 10px; border-radius: 999px; background: #f1f5f8; color: #74859a; font-size: 9px; font-weight: 700; }
.scenario-explanation { margin: 13px 0 15px; color: #6f8095; font-size: 11px; }
.chart-note { display: flex; align-items: center; gap: 8px; padding: 10px 12px; border: 1px solid #f0dfbc; border-radius: 10px; background: #fffaf0; color: #7b6947; font-size: 10px; line-height: 1.55; }
.note-icon { display: grid; width: 17px; height: 17px; flex: 0 0 17px; place-items: center; border-radius: 50%; background: #f2dfb7; color: #745922; font-family: Georgia, serif; font-size: 11px; font-weight: 700; }
.allocation-chart-wrap { min-height: 310px; margin-top: 15px; padding: 12px; border: 1px solid #e7edf2; border-radius: 12px; background: #fbfcfd; }
.allocation-chart-wrap svg { display: block; width: 100%; height: auto; min-height: 280px; overflow: visible; }
.chart-legend { display: flex; justify-content: flex-end; gap: 17px; margin-top: 10px; color: #8491a1; font-size: 9px; }
.chart-legend span { display: inline-flex; align-items: center; gap: 6px; }
.legend-swatch { width: 8px; height: 8px; border-radius: 3px; }
.legend-swatch--selected { background: #316db2; }
.legend-swatch--other { background: #9fc7d4; }
.chart-label { fill: #53667e; font-family: "Noto Sans KR", sans-serif; font-size: 12px; font-weight: 600; }
.chart-gridline { stroke: #e8edf2; stroke-width: 1; }
.chart-track { fill: #edf1f4; }
.chart-bar-selected { fill: #316db2; }
.chart-bar-other { fill: #9fc7d4; }
.chart-bar-cap { fill: #fff; opacity: .22; }

@media (max-width: 1120px) {
  .dashboard-hero {
    grid-template-columns: minmax(220px, .0.85fr) minmax(340px, 1.15fr);
    gap: 16px;
  }
  .dashboard-hero .hero-copy { 
    grid-column: 1 / -1;
    grid-row: 1;
  }
  .date-card {
    grid-column: 2;
    grid-row: 2;
  }
  .port-card {
    grid-column: 2;
    grid-row: 2;
  }
  .scenario-panel {
    grid-column: 1 / -1;
    grid-row: 3;
  }
  .port-card .map-shell {
    height: 280px;
  }
}

@media (max-width: 760px) {
  .dashboard-hero { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; padding-top: 26px; padding-bottom: 30px; overflow: visible; }
  .dashboard-hero .hero-copy { grid-column: 1; grid-row: auto; padding: 0 2px 8px; }
  .dashboard-hero .hero-copy h1 { margin-top: 14px; font-size: 35px; }
  .dashboard-hero .hero-description { font-size: 14px; }
  .date-card, .port-card, .scenario-panel { grid-column: 1; grid-row: auto; }
  .control-card { padding: 17px; border-radius: 15px; }
  .port-card .map-shell { height: 245px; }
  .scenario-panel { grid-template-columns: minmax(0, 1fr); padding: 17px; }
  .scenario-panel-top { display: block; }
  .scenario-volume-summary { max-width: none; margin-top: 8px; text-align: left; }
  .scenario-choice-grid { grid-template-columns: minmax(0, 1fr); }
  .scenario-choice { min-height: 70px; }
  .selection-summary { display: grid; min-width: 0; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .summary-cell { grid-template-columns: 23px 1fr; }
  .summary-cell strong { grid-column: 2; }
  .scenario-panel-actions { align-items: stretch; flex-direction: column; }
  .analyze-button { width: 100%; }
  .input-summary-card { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .input-summary-item:nth-child(2) { border-right: 0; }
  .input-summary-item:nth-child(n + 3) { border-top: 1px solid #edf0f3; }
  .results-layout { grid-template-columns: minmax(0, 1fr); }
  .scenario-tabs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 5px; padding: 10px; }
  .scenario-tabs-label, .edit-input-link { grid-column: 1 / -1; }
  .scenario-tabs-label { margin: 2px 4px 4px; }
  .edit-input-link { margin: 6px 4px 2px; }
  .scenario-tab { grid-template-columns: 1fr; justify-items: center; gap: 3px; min-height: 61px; margin-top: 0; padding: 7px 4px; text-align: center; }
  .scenario-tab b { display: none; }
  .allocation-card { padding: 15px; }
  .allocation-chart-wrap { min-height: 250px; padding: 7px; }
  .allocation-chart-wrap svg { min-height: 235px; }
  .results-heading { padding-top: 20px; }
}

@media (max-width: 420px) {
  .selected-port-row { grid-template-columns: 1fr; }
  .selected-port-copy { padding-bottom: 0; }
  .selection-summary { grid-template-columns: 1fr; }
  .chart-legend { justify-content: flex-start; flex-wrap: wrap; }
  .allocation-card-heading { align-items: flex-start; }
  .allocation-status { flex: 0 0 auto; }
}
